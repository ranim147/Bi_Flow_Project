# Copier ce fichier en .env puis adapter les valeurs. Ne jamais committer .env.

# --- PostgreSQL (utilisé par docker-compose ET par le code Python) ---
POSTGRES_USER=biflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=biflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Base utilisée par les tests (créée automatiquement sur le même serveur)
POSTGRES_TEST_DB=biflow_test

# --- Adminer (interface web pour parcourir la base) ---
ADMINER_PORT=8081

# --- Socrata (NYC Open Data) — optionnel mais recommandé (limite de débit plus haute)
# Créer un token gratuit : https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# --- LLM — optionnel ---
# auto : Mistral si MISTRAL_API_KEY est renseignée, sinon aucun LLM
# mistral : API Mistral (européenne) | ollama : modèle local, aucune donnée ne sort de la machine
# none : baseline sans LLM (règles pour question -> SQL, gabarits pour les insights)
BIFLOW_LLM_PROVIDER=auto
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Ollama (https://ollama.com) : `ollama pull qwen2.5:7b`
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Sécurité / RGPD ---
# Seuil anti-identification : tout agrégat portant sur moins de N demandes est masqué (N à fixer avec le DPO)
BIFLOW_MIN_GROUP_SIZE=10
# SQL généré : nombre de lignes et durée max
BIFLOW_SQL_MAX_ROWS=1000
BIFLOW_SQL_TIMEOUT_SECONDS=10

# --- Orchestrateur ---
BIFLOW_MAX_RETRIES=2
BIFLOW_RETRY_DELAY_SECONDS=1
BIFLOW_MAX_FEEDBACK_ROUNDS=1
LOG_LEVEL=INFO
